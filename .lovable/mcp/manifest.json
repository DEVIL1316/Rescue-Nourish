{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ebrrdovguxpyjhuxzgbt.supabase.co/auth/v1",
    "resource_name": "Rescue & Nourish MCP",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "rescue-nourish-mcp",
      "version": "0.1.0",
      "title": "Rescue & Nourish"
    },
    "tools": [
      {
        "name": "list_ngos",
        "title": "List NGOs",
        "description": "List NGOs registered on the Rescue & Nourish platform (name, description, location, website).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 50,
              "description": "Maximum number of NGOs to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_orphanages",
        "title": "List orphanages",
        "description": "List orphanages on the Rescue & Nourish platform with their current needs description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 50,
              "description": "Maximum number of orphanages to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_open_needs",
        "title": "List open needs",
        "description": "List open medical, clothing, and other needs posted by NGOs and orphanages that donors can help with.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 50,
              "description": "Maximum number of open needs to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
